# Set to PROD in prod. Otherwise, optional
BOMBS_ENV=PROD

# Optional. If set, must set both
BOMBS_ADMIN_USERNAME=admin
BOMBS_ADMIN_PASSWORD=password

BOMBS_DATA_FOLDER=.

# Optional. Recommended not to set.
# can generate with "openssl rand -hex 16 | head -c 32; echo"
BOMBS_JWT_ENCRYPTION_KEY=change_me

# Required Can generate with "openssl rand -hex 16 | head -c 32; echo"
BOMBS_MESSAGE_ENCRYPTION_KEY=change_me
