package components

import (
	"fmt"
	"strconv"

	"github.com/forrest-bajbek/bombs/routes"
	"github.com/forrest-bajbek/bombs/types"
)

// messageFilesURL opens the lightbox at the given 0-based photo index.
func messageFilesURL(chatID int, messageID int, index int) string {
	return routes.URL(routes.PartialChatMessageFiles, strconv.Itoa(chatID), strconv.Itoa(messageID)) + "?i=" + strconv.Itoa(index)
}

func typingURL(chatID int) string {
	return routes.URL(routes.ChatTyping, strconv.Itoa(chatID))
}

// typingText names a lone typist; any more than that are summarized.
func typingText(names []string) string {
	if len(names) == 1 {
		return names[0] + " is typing..."
	}
	return "Two or more people are typing..."
}

func modalCloseURL(chatID int) string {
	return routes.URL(routes.PartialChatModalClose, strconv.Itoa(chatID))
}

func bubbleClass(isSender bool) string {
	if isSender {
		return "message is-sent"
	}
	return "message is-received"
}

// attachmentGridClass drives the CSS grid layout. Anything past four
// photos collapses to the same two-column grid, with the last tile
// standing in for the remainder.
func attachmentGridClass(count int) string {
	if count > types.AttachmentTilesShown {
		return "attachments count-many"
	}
	return fmt.Sprintf("attachments count-%d", count)
}

// visibleAttachments returns the tiles rendered inline. When there are more
// photos than fit, the last slot is given over to the "+n" tile, so only
// AttachmentTilesShown-1 plain tiles are shown.
func visibleAttachments(files []types.MessageFile) []types.MessageFile {
	if len(files) <= types.AttachmentTilesShown {
		return files
	}
	return files[:types.AttachmentTilesShown-1]
}

func hiddenAttachmentCount(files []types.MessageFile) int {
	if len(files) <= types.AttachmentTilesShown {
		return 0
	}
	return len(files) - (types.AttachmentTilesShown - 1)
}

// Timestamps render in UTC: the browser is the only thing that knows the
// viewer's timezone, and converting would cost a line of JavaScript. The
// datetime attribute carries the full value for anyone who hovers.
func messageTimestamp(m *types.ResponseMessage) string {
	return m.MessageCreatedAt.UTC().Format("15:04")
}

func messageTimestampFull(m *types.ResponseMessage) string {
	return m.MessageCreatedAt.UTC().Format("2006-01-02 15:04:05 UTC")
}

templ AttachmentTile(f types.MessageFile, chatID int, messageID int, index int) {
	<button
		class="attachment-tile"
		type="button"
		hx-get={ messageFilesURL(chatID, messageID, index) }
		hx-target="#chat-modal"
		hx-swap="innerHTML"
		aria-label={ fmt.Sprintf("Open photo %d", index+1) }
	>
		<img src={ f.FileURL() } alt="Photo" loading="lazy" decoding="async"/>
	</button>
}

templ AttachmentMoreTile(f types.MessageFile, chatID int, messageID int, hidden int) {
	<button
		class="attachment-more"
		type="button"
		hx-get={ messageFilesURL(chatID, messageID, types.AttachmentTilesShown-1) }
		hx-target="#chat-modal"
		hx-swap="innerHTML"
		aria-label={ fmt.Sprintf("Show all %d photos", hidden+types.AttachmentTilesShown-1) }
	>
		<img src={ f.FileURL() } alt="" loading="lazy" decoding="async"/>
		<span>+{ strconv.Itoa(hidden) }</span>
	</button>
}

templ MessageAttachments(m *types.ResponseMessage) {
	if len(m.Files) > 0 {
		<div class={ attachmentGridClass(len(m.Files)) }>
			for i, f := range visibleAttachments(m.Files) {
				@AttachmentTile(f, m.ChatID, m.MessageID, i)
			}
			if hiddenAttachmentCount(m.Files) > 0 {
				@AttachmentMoreTile(m.Files[types.AttachmentTilesShown-1], m.ChatID, m.MessageID, hiddenAttachmentCount(m.Files))
			}
		</div>
	}
}

// ChatMessageBubble is rendered once per recipient, because IsSender
// differs between them. Both the history replay and the live stream in
// MessageEvents render through here, so there is exactly one definition of
// what a message looks like.
templ ChatMessageBubble(m *types.ResponseMessage) {
	<div class={ bubbleClass(m.IsSender) }>
		<div class="message-body">
			<div class="username">{ "@" + m.Username }</div>
			@MessageAttachments(m)
			if m.Text != "" {
				<div class="message-text">{ m.Text }</div>
			}
			<time class="timestamp" datetime={ messageTimestampFull(m) }>{ messageTimestamp(m) }</time>
		</div>
	</div>
}

// TypingStatus is rendered per recipient with that recipient already left
// out of names, and replaces itself on every "typing" SSE event.
templ TypingStatus(names []string) {
	<div id="typingStatus" class="chat-typing" hidden?={ len(names) == 0 }>
		if len(names) > 0 {
			{ typingText(names) }
		}
	</div>
}

// PartialMessageFileModal shows one photo at a time. Prev/next re-fetch
// this partial with a neighbouring index; at either end the button is
// simply not rendered, so the arrow key bound to it does nothing. The
// handler guarantees index is in range.
templ PartialMessageFileModal(m *types.ResponseMessage, index int) {
	<div class="modal is-active">
		<div
			class="modal-background"
			hx-get={ modalCloseURL(m.ChatID) }
			hx-target="#chat-modal"
			hx-swap="innerHTML"
		></div>
		<div class="modal-content">
			<figure class="lightbox">
				<img src={ m.Files[index].FileURL() } alt="Photo" decoding="async"/>
				if len(m.Files) > 1 {
					<figcaption>{ strconv.Itoa(index+1) } / { strconv.Itoa(len(m.Files)) }</figcaption>
				}
			</figure>
		</div>
		if index > 0 {
			<button
				class="lightbox-nav is-prev"
				type="button"
				aria-label="Previous photo"
				hx-get={ messageFilesURL(m.ChatID, m.MessageID, index-1) }
				hx-trigger="click, keyup[key=='ArrowLeft'] from:body"
				hx-target="#chat-modal"
				hx-swap="innerHTML"
			>&lsaquo;</button>
		}
		if index < len(m.Files)-1 {
			<button
				class="lightbox-nav is-next"
				type="button"
				aria-label="Next photo"
				hx-get={ messageFilesURL(m.ChatID, m.MessageID, index+1) }
				hx-trigger="click, keyup[key=='ArrowRight'] from:body"
				hx-target="#chat-modal"
				hx-swap="innerHTML"
			>&rsaquo;</button>
		}
		<button
			class="modal-close is-large"
			aria-label="close"
			hx-get={ modalCloseURL(m.ChatID) }
			hx-trigger="click, keyup[key=='Escape'] from:body"
			hx-target="#chat-modal"
			hx-swap="innerHTML"
		></button>
	</div>
}

// MessageInputBar is re-rendered by MessageCreate on every send. Swapping
// the whole form is what clears the text box and the file picker, so no
// JavaScript is needed to reset it.
templ MessageInputBar(chatID int, errorMessage string) {
	<form
		class="chat-input-bar"
		hx-post={ messageSendURL(chatID) }
		hx-encoding="multipart/form-data"
		hx-target="this"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type='submit']"
		onpaste="attachPastedImages(this, event)"
	>
		if errorMessage != "" {
			<p class="chat-input-error">{ errorMessage }</p>
		}
		<div class="field has-addons is-fullwidth">
			<div class="control">
				<div class="file is-small">
					<label class="file-label">
						<input
							class="file-input"
							type="file"
							name="files"
							multiple
							accept="image/jpeg,image/png,image/gif,image/webp"
							onchange="updateFileCount(this)"
						/>
						<span class="file-cta">
							<span class="file-label">📎</span>
						</span>
						<span class="file-count"></span>
					</label>
				</div>
			</div>
			<div class="control is-expanded">
				<input
					class="input"
					id="messageInput"
					name="text"
					type="text"
					placeholder="Type a message…"
					autocomplete="off"
					maxlength="1024"
					data-typing-url={ typingURL(chatID) }
				/>
			</div>
			<div class="control">
				<button class="button is-primary" type="submit">Send</button>
			</div>
		</div>
	</form>
}
