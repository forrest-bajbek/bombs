package components

import (
	"strconv"

	"github.com/forrest-bajbek/bombs/routes"
	"github.com/forrest-bajbek/bombs/types"
)

func linkToSSE(chatID int) string {
	return routes.URL(routes.ChatMessageEvents, strconv.Itoa(chatID))
}

func messageSendURL(chatID int) string {
	return routes.URL(routes.ChatMessageCreate, strconv.Itoa(chatID))
}

templ ChatPage(chat *types.Chat) {
	@BasePage(chat.Name) {
  <style>
    /* ── Heights (change these to resize nav / input bar) ── */
    :root {
      --nav-height:  3.25rem;
      --input-height: 5.5rem;
    }

    html, body {
      height: 100%;
      margin: 0;
      overflow: hidden;          /* only the message area scrolls */
    }

    /* ── Fixed navbar ── */
    .chat-navbar {
      position: fixed;
      top:    0;
      left:   0;
      right:  0;
      height: var(--nav-height);
      z-index: 100;
    }

    /* ── Fixed message input bar ── */
    .chat-input-bar {
      position: fixed;
      bottom: 0;
      left:   0;
      right:  0;
      height: var(--input-height);
      z-index: 100;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0;
      background: #0F0F0F;
      border-top: 1px solid #0F0F0F;
    }

		.chat-input-bar .field {
			width: 100%;
			padding: 0 0.75rem;
			margin-bottom: 0;
		}

    .chat-input-error {
      color: #FF6B6B;
      font-size: 0.75rem;
      padding: 0 0.75rem 0.25rem;
    }

    .chat-input-bar .file-count {
      align-self: center;
      font-size: 0.7rem;
      opacity: 0.8;
      padding-left: 0.35rem;
      white-space: nowrap;
    }

    /* ── Reply banner, floats above the input bar ── */
    .chat-reply-banner {
      position: absolute;
      bottom: 100%;
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.35rem 0.75rem;
      background: #1A1A1A;
      border-top: 1px solid #2A2A2A;
      font-size: 0.8rem;
    }

    .chat-reply-banner[hidden] {
      display: none;
    }

    .chat-reply-banner .reply-banner-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* ── Reply preview inside a bubble ── */
    .chat-messages .reply-preview {
      display: block;
      width: 100%;
      margin-bottom: 0.4rem;
      padding: 0.25rem 0.5rem;
      border: 0;
      border-left: 3px solid currentColor;
      border-radius: 0.35rem;
      background: rgba(255, 255, 255, 0.08);
      color: inherit;
      font: inherit;
      font-size: 0.8rem;
      text-align: left;
      cursor: pointer;
    }

    .chat-messages .reply-preview .reply-username {
      display: block;
      font-weight: 600;
    }

    .chat-messages .reply-preview .reply-text {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      opacity: 0.85;
    }

    .chat-messages .message {
      -webkit-touch-callout: none;
    }

    .chat-messages .message.is-highlighted .message-body {
      animation: message-highlight 1.5s ease-out;
    }

    @keyframes message-highlight {
      from { box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.7); }
      to   { box-shadow: 0 0 0 3px rgba(255, 255, 255, 0); }
    }

    /* ── Message context menu ── */
    #messageMenu {
      position: fixed;
      z-index: 300;
      min-width: 9rem;
      padding: 0.25rem 0;
      background: #1F1F1F;
      border: 1px solid #333;
      border-radius: 0.5rem;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    }

    #messageMenu[hidden] {
      display: none;
    }

    #messageMenu button {
      display: block;
      width: 100%;
      padding: 0.6rem 1rem;
      border: 0;
      background: none;
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    #messageMenu button:hover {
      background: #2A2A2A;
    }

    /* ── Scrollable messages area ── */
    .chat-messages {
      position: fixed;
      top:    var(--nav-height);
      bottom: var(--input-height);
      left:   0;
      right:  0;
      overflow-y: auto;
      padding: 1.5rem;
      background: #0F0F0F;
      scroll-behavior: smooth;
    }

    /* Keeps a short conversation pinned to the bottom of the viewport.
       This lives on an inner element rather than the scroll container
       itself, because justify-content on a scroll container makes
       overflowing content unreachable at the top. */
    .chat-messages-inner {
      min-height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    /* ── Bulma message overrides for chat bubbles ── */
    .chat-messages .message {
      margin-bottom: 1rem;
    }

    .chat-messages .message.is-sent {
      margin-left: 30%;
    }

    .chat-messages .message.is-received {
      margin-right: 30%;
    }

    .chat-messages .message .message-body {
      border-radius: 1rem;
    }

    .chat-messages .message.is-sent .message-body {
      background-color: #2150E8;
      color: #ffffff;
    }

    .chat-messages .message.is-received .message-body {
      background-color: #2D2D2D;
      color: #ffffff;
    }

    .chat-messages .message .message-header {
      display: none;            /* hide default Bulma header */
    }

    .chat-messages .message .message-body .timestamp {
      display: block;
      font-size: 0.7rem;
      opacity: 0.7;
      margin-top: 0.25rem;
      text-align: left;
    }

    .chat-messages .message .message-body .username {
      font-size: 0.7rem;
      opacity: 0.7;
      margin-top: 0.25rem;
      text-align: left;
    }

    .chat-messages .message .message-body .message-text {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    /* ── Photo attachments ── */
    .attachments {
      display: grid;
      gap: 2px;
      margin: 0.35rem 0 0.5rem;
      border-radius: 0.75rem;
      overflow: hidden;
      max-width: min(20rem, 60vw);
    }

    .attachments img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      background: #1a1a1a;
    }

    /* A lone photo keeps its shape instead of being cropped square. */
    .attachments.count-1 { grid-template-columns: 1fr; }
    .attachments.count-1 img {
      height: auto;
      max-height: 20rem;
      object-fit: contain;
    }

    .attachments.count-2 { grid-template-columns: repeat(2, 1fr); }
    .attachments.count-3 { grid-template-columns: repeat(3, 1fr); }
    .attachments.count-4,
    .attachments.count-many { grid-template-columns: repeat(2, 1fr); }

    .attachments.count-2 img,
    .attachments.count-3 img,
    .attachments.count-4 img,
    .attachments.count-many img { aspect-ratio: 1; }

    .attachment-tile,
    .attachment-more {
      position: relative;
      padding: 0;
      border: none;
      background: none;
      cursor: pointer;
      display: block;
      width: 100%;
    }

    .attachment-more img { filter: brightness(0.4); }

    .attachment-more span {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 600;
      color: #ffffff;
    }

    /* Bulma's modal sits at z-index 40, below the fixed nav and input bar. */
    .modal { z-index: 200; }

    .modal-content { width: min(90vw, 60rem); }

    .lightbox { margin: 0; }

    .lightbox img {
      display: block;
      max-width: 100%;
      max-height: 80vh;
      margin: auto;
      object-fit: contain;
    }

    .lightbox figcaption {
      margin-top: 0.5rem;
      text-align: center;
      color: #ffffff;
    }

    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 1;
      width: 3rem;
      height: 3rem;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: rgba(10, 10, 10, 0.5);
      color: #ffffff;
      font-size: 2rem;
      line-height: 1;
      cursor: pointer;
    }

    .lightbox-nav:hover { background: rgba(10, 10, 10, 0.8); }
    .lightbox-nav.is-prev { left: 1rem; }
    .lightbox-nav.is-next { right: 1rem; }

    /* Overlays the message area's bottom padding, so showing it never
       shifts the conversation. */
    .chat-typing {
      position: fixed;
      bottom: var(--input-height);
      left: 0;
      right: 0;
      padding: 0.25rem 1.5rem;
      font-size: 0.75rem;
      font-style: italic;
      color: #888;
      background: #0F0F0F;
      z-index: 100;
    }

    body.is-dragging-files .chat-input-bar {
      outline: 2px dashed #485fc7;
      outline-offset: -4px;
    }
  </style>

			// Nav
			<nav class="navbar chat-navbar">
				<div class="navbar-brand">
					<a class="navbar-item button" href={ routes.URL(routes.Home) }>Back</a>
					<a class="navbar-item" href={ chat.ChatProfileLink() }>{ chat.Name }</a>
				</div>
			</nav>

			// Live message stream. The receivers sit outside .chat-messages on
			// purpose: the bomb event swaps innerHTML on the container, so a
			// receiver nested inside would delete itself and stop listening.
			<div hx-ext="sse" sse-connect={ linkToSSE(chat.ID) }>
				<div hidden sse-swap="newMessage" hx-target="#chatMessages" hx-swap="beforeend"></div>
				<div hidden sse-swap="bomb" hx-target="#chatMessages" hx-swap="innerHTML"></div>
				<div hidden sse-swap="messageDeleted" hx-swap="none"></div>
				<div hidden sse-swap="typing" hx-target="#typingStatus" hx-swap="outerHTML"></div>
			</div>

			// Messages
			<div class="chat-messages" hx-on::after-swap="this.scrollTop = this.scrollHeight">
				<div class="chat-messages-inner" id="chatMessages"></div>
			</div>

			// Who else is typing. Outside .chat-messages for the same reason as
			// the receivers above: a bomb would otherwise delete it.
			@TypingStatus(nil)

			// Attachment modal target. A sibling of .chat-messages so that
			// bombing the chat can't tear the open modal out of the DOM.
			<div id="chat-modal"></div>

			// Message context menu. Outside .chat-messages so a bomb can't remove it.
			<div id="messageMenu" hidden>
				<button type="button" data-action="reply">Reply to message</button>
				<button type="button" data-action="delete">Delete message</button>
			</div>

			// Input Bar
			@MessageInputBar(chat.ID, "")
			<script>
				// ── Message context menu: right-click or long-press a message ──
				const LONG_PRESS_MS = 500;
				const LONG_PRESS_MOVE_PX = 10;
				const messageMenu = document.getElementById('messageMenu');
				const chatMessages = document.getElementById('chatMessages');
				let menuMessage = null;
				let longPressTimer = null;
				let longPressStart = null;

				function hideMessageMenu() {
					messageMenu.hidden = true;
					menuMessage = null;
				}

				function showMessageMenu(message, x, y) {
					menuMessage = message;
					// Only the sender can delete.
					messageMenu.querySelector('[data-action="delete"]').hidden = !message.hasAttribute('data-sent');
					messageMenu.hidden = false;
					const maxX = window.innerWidth - messageMenu.offsetWidth - 4;
					const maxY = window.innerHeight - messageMenu.offsetHeight - 4;
					messageMenu.style.left = Math.max(4, Math.min(x, maxX)) + 'px';
					messageMenu.style.top = Math.max(4, Math.min(y, maxY)) + 'px';
				}

				function messageFromEvent(e) {
					const message = e.target.closest('.message[data-message-id]');
					return message && chatMessages.contains(message) ? message : null;
				}

				chatMessages.addEventListener('contextmenu', e => {
					const message = messageFromEvent(e);
					if (!message) return;
					e.preventDefault();
					showMessageMenu(message, e.clientX, e.clientY);
				});

				chatMessages.addEventListener('touchstart', e => {
					const message = messageFromEvent(e);
					if (!message || e.touches.length !== 1) return;
					const touch = e.touches[0];
					longPressStart = { x: touch.clientX, y: touch.clientY };
					clearTimeout(longPressTimer);
					longPressTimer = setTimeout(() => {
						longPressTimer = null;
						showMessageMenu(message, longPressStart.x, longPressStart.y);
					}, LONG_PRESS_MS);
				}, { passive: true });
				chatMessages.addEventListener('touchmove', e => {
					if (!longPressTimer) return;
					const touch = e.touches[0];
					if (Math.hypot(touch.clientX - longPressStart.x, touch.clientY - longPressStart.y) > LONG_PRESS_MOVE_PX) {
						clearTimeout(longPressTimer);
						longPressTimer = null;
					}
				}, { passive: true });
				['touchend', 'touchcancel'].forEach(type => chatMessages.addEventListener(type, () => {
					clearTimeout(longPressTimer);
					longPressTimer = null;
				}));

				messageMenu.addEventListener('click', e => {
					const action = e.target.closest('button')?.dataset.action;
					if (!action || !menuMessage) return;
					const message = menuMessage;
					hideMessageMenu();
					if (action === 'reply') startReply(message);
					if (action === 'delete') htmx.ajax('POST', message.dataset.deleteUrl, { source: message, swap: 'none' });
				});

				// Dismiss on any tap elsewhere, scroll, or Escape. Capture phase so
				// the tap that closes the menu doesn't also act on what is under it.
				document.addEventListener('pointerdown', e => {
					if (!messageMenu.hidden && !messageMenu.contains(e.target)) hideMessageMenu();
				}, true);
				document.addEventListener('keydown', e => {
					if (e.key === 'Escape') hideMessageMenu();
				});
				document.querySelector('.chat-messages').addEventListener('scroll', hideMessageMenu, { passive: true });

				// ── Replies ──
				// The banner and hidden input live in the input bar, which is
				// re-rendered after every send, so a reply resets itself.
				function startReply(message) {
					document.getElementById('replyToInput').value = message.dataset.messageId;
					const username = message.querySelector('.username').textContent;
					const text = message.querySelector('.message-text')?.textContent || '📷 Photo';
					const banner = document.getElementById('replyBanner');
					banner.querySelector('.reply-banner-text').textContent = 'Replying to ' + username + ': ' + text;
					banner.hidden = false;
					document.getElementById('messageInput').focus();
				}

				function cancelReply() {
					document.getElementById('replyToInput').value = '';
					document.getElementById('replyBanner').hidden = true;
				}

				function scrollToMessage(messageID) {
					const message = document.getElementById('msg-' + messageID);
					if (!message) return;
					message.scrollIntoView({ block: 'center' });
					message.classList.remove('is-highlighted');
					// Force reflow so the animation restarts on repeated clicks.
					void message.offsetWidth;
					message.classList.add('is-highlighted');
				}


				// Shows how many photos are queued on the input bar's file picker.
				function updateFileCount(input) {
					input.closest('.file').querySelector('.file-count').textContent = input.files.length ? input.files.length + ' 📷' : '';
				}

				// Appends images to the input bar's file picker so they upload
				// exactly as if picked with 📎. Returns whether anything was attached.
				// The input is looked up live because the form is re-rendered after
				// every send.
				function attachImages(files) {
					const input = document.querySelector('.chat-input-bar input[name="files"]');
					const allowed = input.accept.split(',');
					const images = Array.from(files).filter(f => allowed.includes(f.type));
					if (!images.length) return false;

					const dt = new DataTransfer();
					for (const f of input.files) dt.items.add(f);
					images.forEach((f, i) => {
						// The server drops parts with an empty filename, so give nameless
						// images one.
						if (!f.name) f = new File([f], 'pasted-' + i + '.' + f.type.split('/')[1], { type: f.type });
						dt.items.add(f);
					});
					input.files = dt.files;
					updateFileCount(input);
					return true;
				}

				// Plain text pastes fall through.
				function attachPastedImages(form, event) {
					if (attachImages(event.clipboardData?.files || [])) event.preventDefault();
				}

				// Drag and drop photos anywhere on the page. Registered on document so
				// the listeners survive form re-renders.
				const hasFiles = e => e.dataTransfer?.types.includes('Files');
				document.addEventListener('dragenter', e => {
					if (hasFiles(e)) document.body.classList.add('is-dragging-files');
				});
				document.addEventListener('dragover', e => {
					if (hasFiles(e)) e.preventDefault();
				});
				document.addEventListener('dragleave', e => {
					if (e.relatedTarget === null) document.body.classList.remove('is-dragging-files');
				});
				document.addEventListener('drop', e => {
					if (!hasFiles(e)) return;
					e.preventDefault();
					document.body.classList.remove('is-dragging-files');
					attachImages(e.dataTransfer.files);
				});

				// Tells the server this user is typing: one ping on the first key,
				// then at most one trailing ping per second while keys keep coming.
				// The server drops a typist 3s after their last ping. Registered on
				// document so it survives the input bar being re-rendered.
				const TYPING_THROTTLE_MS = 1000;
				let typingThrottle = null;
				let typingPending = false;
				function sendTyping() {
					const input = document.getElementById('messageInput');
					if (input) fetch(input.dataset.typingUrl, { method: 'POST' });
				}
				function startTypingWindow() {
					typingThrottle = setTimeout(() => {
						typingThrottle = null;
						if (typingPending) {
							typingPending = false;
							sendTyping();
							startTypingWindow();
						}
					}, TYPING_THROTTLE_MS);
				}
				document.addEventListener('keydown', e => {
					if (e.target.id !== 'messageInput') return;
					// Enter sends the message, which clears this user's typing on the
					// server; a ping now would mark them typing again.
					if (e.key.length !== 1 && e.key !== 'Backspace' && e.key !== 'Delete') return;
					if (typingThrottle) {
						typingPending = true;
						return;
					}
					sendTyping();
					startTypingWindow();
				});
				document.addEventListener('submit', () => {
					clearTimeout(typingThrottle);
					typingThrottle = null;
					typingPending = false;
				});
			</script>
	}
}
