package components

import (
	"github.com/forrest-bajbek/bombs/types"
	"fmt"
)

func linkToSSE(chatID int) string {
	return fmt.Sprintf("/chat/%d/message/events", chatID)
}

func messageSendURL(chatID int) string {
	return fmt.Sprintf("/chat/%d/message/create", chatID)
}

templ ChatPage(chat *types.Chat) {
	@BasePage(chat.Name) {
  <style>
    /* ── Heights (change these to resize nav / input bar) ── */
    :root {
      --nav-height:  3.25rem;
      --input-height: 4.5rem;
    }

    html, body {
      height: 100%;
      margin: 0;
      overflow: hidden;          /* only the message area scrolls */
    }

    /* ── Fixed navbar ── */
    .chat-navbar {
      position: fixed;
      top:    0;
      left:   0;
      right:  0;
      height: var(--nav-height);
      z-index: 100;
    }

    /* ── Fixed message input bar ── */
    .chat-input-bar {
      position: fixed;
      bottom: 0;
      left:   0;
      right:  0;
      height: var(--input-height);
      z-index: 100;
      display: flex;
      align-items: center;
      padding: 0;
      background: #0F0F0F;
      border-top: 1px solid #0F0F0F;
    }

		.chat-input-bar .field {
			width: 100%;
			padding: 0 0.75rem;
		}

    /* ── Scrollable messages area ── */
    .chat-messages {
      position: fixed;
      top:    var(--nav-height);
      bottom: var(--input-height);
      left:   0;
      right:  0;
      overflow-y: auto;
      padding: 1.5rem;
      background: #0F0F0F;
    }

    /* ── Bulma message overrides for chat bubbles ── */
    .chat-messages .message {
      margin-bottom: 1rem;
    }

    .chat-messages .message.is-sent {
      margin-left: 30%;
    }

    .chat-messages .message.is-received {
      margin-right: 30%;
    }

    .chat-messages .message .message-body {
      border-radius: 1rem;
    }

    .chat-messages .message.is-sent .message-body {
      background-color: #2150E8;
      color: #ffffff;
    }

    .chat-messages .message.is-received .message-body {
      background-color: #2D2D2D;
      color: #ffffff;
    }

    .chat-messages .message .message-header {
      display: none;            /* hide default Bulma header */
    }

    .chat-messages .message .message-body .timestamp {
      font-size: 0.7rem;
      opacity: 0.7;
      margin-top: 0.25rem;
      text-align: left;
    }

    .chat-messages .message .message-body .username {
      font-size: 0.7rem;
      opacity: 0.7;
      margin-top: 0.25rem;
      text-align: left;
    }

  </style>

			// Nav
			<nav class="navbar chat-navbar">
				<div class="navbar-brand">
					<a class="navbar-item button" href="/">Back</a>
					<a class="navbar-item" href={ chat.ChatProfileLink() }>{ chat.Name }</a>
				</div>
			</nav>

			// Messages
			<div class="chat-messages" id="chatMessages"></div>

			// Input Bar
			<div class="chat-input-bar">
				<div class="field has-addons is-fullwidth">
					<div class="control is-expanded">
						<input
							class="input"
							id="messageInput"
							type="text"
							placeholder="Type a message…"
							autocomplete="off"
							onkeydown="if (event.key === 'Enter') sendMessage()"
						>
					</div>
					<div class="control">
						<button class="button is-primary" id="sendBtn" onclick="sendMessage()">Send</button>
					</div>
				</div>
			</div>

			<script>
				// Setup
				// ----------------------------------------------------------------------------
				const messageFeed = new EventSource({{ linkToSSE(chat.ID) }});
				const messagesContainer = document.getElementById('chatMessages');
				const messageInput = document.getElementById('messageInput');
				const sendBtn = document.getElementById('sendBtn');

				messagesContainer.scrollTop = messagesContainer.scrollHeight;

				// Message Feed
				// ----------------------------------------------------------------------------
				// Handle messages
				messageFeed.addEventListener("newMessage", (event) => {
					const m = JSON.parse(event.data);
					const messageDiv = document.createElement('div');
					messageDiv.className = m.is_sender ? "message is-sent" : "message is-received";
					messageDiv.innerHTML = `
						<div class="message-body">
							<div class="username">@${ m.username }</div>
							${ m.text }
							<div class="timestamp">${ m.message_created_at }</div>
						</div>
					`;
					messagesContainer.append(messageDiv);

					// Smooth scroll to the new message
					messagesContainer.scrollTo({
						top: messagesContainer.scrollHeight,
						behavior: 'smooth'
					});
				});

				// Handle bombs
				messageFeed.addEventListener("bomb", (event) => {
					const m = JSON.parse(event.data);
					const messageDiv = document.createElement('div');
					messageDiv.className = m.is_sender ? "message is-sent" : "message is-received";
					messageDiv.innerHTML = `
						<div class="message-body">
							<div class="username">@${ m.username }</div>
							${ m.text }
							<div class="timestamp">${ m.message_created_at }</div>
						</div>
					`;
					messagesContainer.replaceChildren() // Remove all messages
					messagesContainer.append(messageDiv);

					// Smooth scroll to the new message
					messagesContainer.scrollTo({
						top: messagesContainer.scrollHeight,
						behavior: 'smooth'
					});
				});

				messageFeed.onerror = (error) => {
					console.error('SSE error:', error);
					messageFeed.close();
				};

				// close event source when leaving page
				window.addEventListener('beforeunload', () => {
						messageFeed.close();
				});
				window.addEventListener('onunload', () => {
						messageFeed.close();
				});
				navigation.addEventListener("navigate", e => {
						messageFeed.close();
				});

				// Message Form
				// ----------------------------------------------------------------------------
				async function sendMessage() {
					const text = messageInput.value.trim();
					if (!text) return;

					sendBtn.disabled = true;
					sendBtn.textContent = 'Sending...';

					try {
						result = await fetch({{ messageSendURL(chat.ID) }}, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({text})
						});
						messageInput.value = '';
						messageInput.focus();
					} catch (error) {
						console.error('Failed to send message:', error);
						window.location.reload();
					} finally {
						sendBtn.disabled = false;
						sendBtn.textContent = 'Send';
					}
				};
			</script>
	}
}
